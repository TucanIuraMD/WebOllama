# WebOllama Configuration
# Copy to .env and edit

# Ollama API endpoint
OLLAMA_URL=http://127.0.0.1:11434

# Sysinfo endpoint (optional — for remote GPU/system data)
SYSINFO_URL=

# Web UI server
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080

# Refresh intervals (seconds)
REFRESH_INTERVAL=1.0
METRICS_INTERVAL=5.0

# History retention (seconds, default 1 hour)
HISTORY_RETENTION=3600

# Authentication
AUTH_ENABLED=true
# Default admin user (created on first run)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=changeme

# GPU monitoring
GPU_ENABLED=true

# V100 fan control (v100-fan.service — ESP32 controller)
# Optional state file; if empty the reader parses journalctl -u v100-fan.service
V100_FAN_STATE_FILE=
# Poll interval for journalctl (seconds) — the service logs only PWM changes
V100_FAN_POLL_INTERVAL=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/webui.log

# Database
DB_PATH=data/webui.db

# Secret key for sessions (auto-generated if empty)
SECRET_KEY=